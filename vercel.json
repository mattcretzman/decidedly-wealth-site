{
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.decidedlywealth.com"
        }
      ],
      "destination": "https://decidedlywealth.com/$1",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/who-we-are.html",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/ads-email?key=dwm-ops-2026",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/book-drip?key=dwm-ops-2026",
      "schedule": "0 15 * * *"
    }
  ]
}
